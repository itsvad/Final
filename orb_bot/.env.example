# Copy to .env and fill in your Tradovate credentials.
# Never commit your real .env file.

# Tradovate login credentials (same as the Tradovate Trader app)
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=

# Tradovate API application credentials (from tradovate.com/api or your
# broker's Tradovate API access page)
TRADOVATE_APP_ID=orb-bot
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=

# Optional: only needed if your login has 2FA / device tokens enabled
TRADOVATE_DEVICE_ID=
